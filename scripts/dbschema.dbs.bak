<project name="DuckDB" database="DuckDB" id="ebeaa3a3-5932-4d90-9480-3d34f8a99459" >
	<schema name="standardized" >
		<table name="gps_positions" spec="" >
			<column name="transport_type" type="BIGINT" />
			<column name="line_number" type="VARCHAR" />
			<column name="vehicle_id" type="BIGINT" />
			<column name="fleet_number" type="BIGINT" />
			<column name="lat" type="DOUBLE" />
			<column name="lon" type="DOUBLE" />
			<column name="heading_deg" type="BIGINT" />
			<column name="speed_kmh" type="VARCHAR" />
			<column name="floor_type" type="VARCHAR" />
			<column name="destination" type="VARCHAR" />
			<column name="source" type="VARCHAR" length="100" todo="Blue" />
			<column name="snapshot_ts" type="TIMESTAMP" todo="Blue" />
			<column name="snapshot_date" type="DATE" todo="Blue" />
		</table>
		<table name="gtfs_calendar" spec="" >
			<column name="service_id" type="BIGINT" />
