[sqlfluff]
dialect = duckdb
max_line_length = 120
templater = raw
ignore = parsing


[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = leading:align-following

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = False
indented_ctes = True
indented_using_on = True
template_blocks_ident = True

# ----------------------

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
unquoted_identifiers_policy = all


[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.keywords] 
capitalisation_policy = upper


[sqlfluff:rules:convention.select_trailing_comma]
select_clause_trailing_comma = forbid








[sqlfluff:rules:layout.spacing]
no_trailing_whitespace = true
extra_whitespace = false

[sqlfluff:rules:layout.cte_newline]
# A blank line must be added after a CTE
# Can be fixed automatically

[sqlfluff:rules:layout.cte_bracket]



[sqlfluff:rules:layout.functions]



[sqlfluff:rules:structure.simple_case]
# Unnecessary CASE statement.
# Usually, replaces with COALESCE (more efficient)
# Can be fixed automatically

[sqlfluff:rules:ambiguous.column_count]
# Never use * in SELECT
# NOTE : this does not raise error if * is used in CTEs

[sqlfluff:rules:layout.start_of_file]
# Files must not begin with newlines or whitespace.
# Can be fixed automatically


[sqlfluff:rules:convention.statement_brackets]
# Top-level statements should not be wrapped in brackets.
# Can be fixed automatically

[sqlfluff:rules:structure.nested_case]
# Nested CASE statement in ELSE clause could be flattened.
# Can be fixed automatically

[sqlfluff:rules:references.quoting]
# Policy on quoted and unquoted identifiers
prefer_quoted_identifiers = False
prefer_quoted_keywords = False
ignore_words = None
ignore_words_regex = None


[sqlfluff:rules:references.keywords]




[sqlfluff:rules:convention.coalesce]
# Use COALESCE instead of IFNULL or NVL.
# Can be fixed automatically

[sqlfluff:rules:structure.subquery]
# Join/From clauses should not contain subqueries. Use CTEs instead.
forbid_subquery_in = both

[sqlfluff:rules:layout.select_modifiers]
# SELECT modifiers (e.g. DISTINCT) must be on the same line as SELECT.
# Can be fixed automatically



#----------------



[sqlfluff:layout:type:common_table_expression]
# Enforce newlines for CTEs to align with common formatting
spacing_within = single



[sqlfluff:rules:ambiguous.join]
fully_qualify_join_types = inner



[sqlfluff:rules:convention.terminator]
require_final_semicolon = False



[sqlfluff:rules:layout.newlines]
maximum_empty_lines_between_statements = 1
maximum_empty_lines_inside_statements = 0
maximum_empty_lines_between_batches = 1

#--------------------------------------------#

[sqlfluff:layout:type:partitionby_clause]
line_position = alone:strict
keyword_line_position = leading:strict
#--------------------------------------------#

[sqlfluff:layout:type:orderby_clause]
line_position = alone:strict
keyword_line_position = leading:strict

[sqlfluff:layout:type:qualify_clause]
line_position = alone:strict
keyword_line_position = leading:strict


[sqlfluff:layout:type:over_clause]
line_position = trailing:strict
keyword_line_position = trailing:strict

[sqlfluff:layout:type:where_clause]
line_position = alone:strict
keyword_line_position = leading:strict


[sqlfluff:layout.keyword_newline]
line_position = alone:strict
keyword_line_position = leading:strict


##--------------


[sqlfluff:rules:aliasing.unique.table]
# Table aliases should be unique within each clause.

[sqlfluff:rules:ambiguous.distinct]
# DISTINCT and GROUP BY should not be used in same SELECT statement

[sqlfluff:rules:ambiguous.column_references]
# GROUP BY/ORDER BY column references
group_by_and_order_by_style = implicit


[sqlfluff:rules:aliasing.unused]
# Tables should not be aliased if that alias is not used.
# Can be fixed automatically


[sqlfluff:rules:references.from]
# References must be in FROM clause

[sqlfluff:rules:references.qualification]
# References must be applied if there is more than one aliased table in SELECT statement




#[sqlfluff:rules:references.consistent]
#single_table_references = unqual



#[sqlfluff:rules:aliasing.table]
#aliasing = explicit

#[sqlfluff:rules:aliasing.column]
## Aliasing preference for columns
#aliasing = explicit

#[sqlfluff:rules:aliasing.unused]
#aliasing = explicit

[sqlfluff:rules:convention.not_equal]
# Consistent usage of preferred "not equal to" comparison
preferred_not_equal_style = c_style


[sqlfluff:rules:convention.casting_style]
preferred_type_casting_style = shorthand

[sqlfluff:layout.operators]
operator_new_lines = after


# [sqlfluff:rules:layout.select_targets]

[sqlfluff:rules:layout.select_targets]
single_target_policy = same_line 
wildcard_policy = single

[tool.sqlfluff.layout.type.keyword]
spacing_before = "align"

[tool.sqlfluff.layout.type.binary_operator]
spacing_before = "align"

[tool.sqlfluff.layout.type.comparison_operator]
spacing_before = "align"