	<diagram_group name="Default" id="996f98bc-88cd-468a-b2e4-091050e19b64" >
		<diagram name="Diagram" id="7d0943bd-b38c-421a-b1ef-d7a361706b1f" show_column_type="y" show_schema_name="y" show_relation="columns" >
			<entity schema="standardized" name="gps_positions" color="3986C1" x="190" y="133" />
