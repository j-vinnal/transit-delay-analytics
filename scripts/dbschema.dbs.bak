			<entity schema="standardized" name="route8_positions" color="3986C1" x="456" y="133" />
			<group name="GPS" color="FF8080" >
				<comment><![CDATA[Filter `transport_type == 2` and `line_number == "8"`. Drop all other vehicles.]]></comment>
				<entity schema="standardized" name="gps_positions" />
				<entity schema="standardized" name="route8_positions" />
				<callout x="475" y="95" pointer="SV" />
			</group>
			<group name="GTFS" color="99B3FF" >
